# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
*.dmg

# Virtual environments
venv/
env/
.env/
.venv/

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*.code-workspace

# Jupyter Notebook
.ipynb_checkpoints

# Data files that shouldn't be version controlled
*.csv
*.json
*.txt
!requirements.txt
*.joblib
*.ics

# Sphinx-generated HTML output; docs/*.rst and conf.py are tracked
docs/_build/
mkdocs.yml

# Logs
*.log
log.txt

# macOS specific
.DS_Store

# Local configuration
.env
.env.local
config.ini

# Ignore GIFs in the root
/*.gif

# Files not ready for release
staging/

# Temporary files
tmp/
temp/
*.tmp
.trash/
./learn*/
./myiac*/

# Temporary shell scripts
run*.sh
