# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
*.dmg

# Virtual environments
venv/
env/
.env/
.venv/

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*.code-workspace

# Jupyter Notebook
.ipynb_checkpoints

# Data files that shouldn't be version controlled
*.csv
*.json
*.txt
!requirements.txt
*.joblib
*.ics

# Sphinx-generated HTML output; docs/*.rst and conf.py are tracked
docs/_build/
mkdocs.yml

# Logs
*.log
log.txt

# macOS specific
.DS_Store

# Local configuration
.env
.env.local
config.ini

# Private, local-only Claude instructions
/CLAUDE.md

# Ignore GIFs in the root
/*.gif

# Files not ready for release
staging/

# Temporary files
tmp/
temp/
*.tmp
.trash/
./learn*/
./myiac*/

# Temporary shell scripts (repo-root only; services/*/run.sh wrappers are tracked)
/run*.sh

# OpenTofu / Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Vault unseal keys / root token (also caught by the blanket *.json rule above)
vault-cluster-keys.json

# Rendered Ansible inventory (regenerated by local_file.ansible_inventory)
provisioning/*/inventory.ini
