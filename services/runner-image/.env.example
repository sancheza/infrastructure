# Copy to .env (gitignored) and fill in real values. Never commit .env.
# See gitops_setup_guide.md §3.1 for how to create a dedicated,
# fine-grained token for ATLANTIS_GH_TOKEN rather than reusing one.

ATLANTIS_GH_USER=your-github-username
ATLANTIS_GH_TOKEN=your-dedicated-fine-grained-token
ATLANTIS_GH_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32
ATLANTIS_REPO_ALLOWLIST=github.com/sancheza/infrastructure
