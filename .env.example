# Example environment configuration for wifi-ap-survey and asus_ap_kuma_monitor.sh
# Copy this file to .env and supply values for your environment.

# Netgear Router Web Admin Password
NETGEAR_PASSWORD=your_netgear_password

# Verizon Fios Router Web Admin Password & Username
VERIZON_PASSWORD=your_verizon_password
VERIZON_USERNAME=admin

# Ubiquiti UniFi Controller
UNIFI_USER=admin
UNIFI_PASSWORD=your_unifi_password
UNIFI_SITE=default

# OpenWrt Access Points
OPENWRT_USER=root
# OPENWRT_KEY=~/.ssh/id_rsa

# MikroTik RouterOS
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=your_mikrotik_password

# TP-Link Omada Controller
TPLINK_USER=admin
TPLINK_PASSWORD=your_tplink_password
TPLINK_SITE=Default

# ASUS access point monitor (asus_ap_kuma_monitor.sh)
# Access points as IP:BACKHAUL_PORT, comma-separated (for example 192.168.0.21:2,192.168.0.22:3)
ASUS_AP_LIST=
# SSID that every access point must broadcast on 2.4 GHz
ASUS_AP_SSID_24=
# SSID that every access point must broadcast on 5 GHz
ASUS_AP_SSID_5=
# Linux account name used for SSH to the access points (default: admin)
ASUS_AP_SSH_USER=
# Uptime Kuma push URL (for example http://kuma.lan:3001/api/push/TOKEN)
KUMA_URL=
