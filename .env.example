# Example environment configuration for wifi-ap-survey
# Copy this file to .env and supply credentials for your environment.

# Netgear Router Web Admin Password
NETGEAR_PASSWORD=your_netgear_password

# Verizon Fios Router Web Admin Password & Username
VERIZON_PASSWORD=your_verizon_password
VERIZON_USERNAME=admin

# Ubiquiti UniFi Controller
UNIFI_USER=admin
UNIFI_PASSWORD=your_unifi_password
UNIFI_SITE=default

# OpenWrt Access Points
OPENWRT_USER=root
# OPENWRT_KEY=~/.ssh/id_rsa

# MikroTik RouterOS
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=your_mikrotik_password

# TP-Link Omada Controller
TPLINK_USER=admin
TPLINK_PASSWORD=your_tplink_password
TPLINK_SITE=Default
