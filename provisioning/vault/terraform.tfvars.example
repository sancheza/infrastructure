# Copy this file to terraform.tfvars (gitignored) and fill in real values.
# Never commit terraform.tfvars: it holds live credentials.

# *NOTE: EDIT REQUIRED* - Set to your Proxmox node API endpoint IP and port
pve_endpoint = "https://192.168.1.10:8006/"

# *NOTE: EDIT REQUIRED* - Provide your Proxmox API token (Format: USER@REALM!TOKENID=UUID)
# Create with pveum user token add root@pam opentofu --privsep 0
# Confirm with pveum user token list root@pam
pve_api_token = "root@pam!opentofu=00000000-0000-0000-0000-000000000000"

# *NOTE: EDIT REQUIRED* - Set to your Proxmox node name (e.g., pve)
pve_node_name = "proxmox"

# *NOTE: EDIT REQUIRED* - Paste the exact string output of `cat /root/.ssh/id_infra.pub`
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1l... root@opentofu"

# *NOTE: EDIT REQUIRED* - Set to your personal/admin public key for direct human SSH access
vault_admin_ssh_key = "ssh-ed25519 AAAAC3NzaC1l... you@example.com"

# *NOTE: EDIT REQUIRED* - Specify VMID for the Vault LXC (default 133)
vault_vmid = 133

# *NOTE: EDIT REQUIRED* - Set the exact deterministic MAC address to assign to Vault
# Use the following command on the Proxmox host to find a free one:
#   while MAC=$(printf 'BC:24:11:%02X:%02X:%02X\n' $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)))
#   grep -rqsi "$MAC" /etc/pve/lxc /etc/pve/qemu-server; do :; done; echo "$MAC"
vault_mac_address = "BC:24:11:0B:E1:31"

# *NOTE: EDIT REQUIRED* - Set the hostname for the Vault LXC
vault_hostname = "vault"

# *NOTE: EDIT REQUIRED* - Set the Pi-hole host_type reservation section this host belongs to
# Check valid labels with:
#   ssh root@<pihole-host> "grep -E '^#.*\.[0-9]{1,3}\s+to\s+\.[0-9]{1,3}' /root/scripts/macaddr.txt"
vault_host_type = "Servers"

# *NOTE: EDIT REQUIRED* - Set target Proxmox storage pool (e.g., local-lvm, local-zfs)
pve_storage_pool = "local-zfs"

# *NOTE: EDIT REQUIRED* - Set exact template storage ID present on your Proxmox node
# Find with: pvesm list local --content vztmpl
pve_template_id = "local:vztmpl/debian-12-standard_12.12-1_amd64.tar.zst"

# *NOTE: EDIT REQUIRED* - Set full URL to your Pi-hole registration microservice
pihole_service_url = "http://192.168.0.8:8600/reservations"

# *NOTE: EDIT REQUIRED* - Set bearer authentication token for your microservice
pihole_api_key = "YOUR_SECURE_BEARER_TOKEN"
